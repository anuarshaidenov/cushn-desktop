{
  "name": "cushn-desktop",
  "version": "0.1.3",
  "private": true,
  "description": "Cushn Desktop: a local-first budgeting app.",
  "author": "Anuar Shaidenov",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@base-ui/react": "~1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "0.22.0",
    "@tanstack/react-query": "~5.104.5",
    "@tanstack/react-router": "~1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uidotdev/usehooks": "^2.4.1",
    "@vgpu/wgsl": "^0.6.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.11",
    "electron": "~44.9.3",
    "electron-builder": "^26.18.1",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-resizable-panels": "^3.0.6",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vgpu": "^0.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  }
}
